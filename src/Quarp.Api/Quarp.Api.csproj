<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- CODESTYLE: every member of the cartridge-facing surface carries XML docs, so CS1591
         stays on — an undocumented public member is a build error, not a habit. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
