<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Same versions as the other test projects: one restore graph, no surprise upgrades. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <!-- The tool itself. Until M4 no test project referenced it, so everything the CLI owns
         alone - the `quarp new` template, the argument parsing, the silent-PCM digest CI
         compares every run against - was untestable by construction, and at least two of those
         had a copy in a test file standing in for the real thing.

         Referencing an OutputType=Exe project is deliberate and is not a workaround: a test
         project may reference an executable, the compiler treats it as an ordinary assembly
         reference, and MSBuild copies the apphost (quarp.exe) and its runtimeconfig/deps next
         to the test assembly. That apphost is what CliProcess runs, which is how the parts
         living in Program.cs's top-level statements (`quarp new`, the break-at parser) get
         tested at all. The alternative, moving CartTemplate and AudioSilenceCommand into a
         library so a test could see them, would reshape the product to suit the test runner.
         (CartTemplate later did move to CartKit - boot-menu wave, M9 stage 4 - but for the
         opposite reason: the shell's CREATE GAME became a second product caller of the same
         writer. The product reshaped itself; the runner still goes through the child
         process for everything Program.cs owns.) -->
    <ProjectReference Include="..\..\src\Quarp.Cli\Quarp.Cli.csproj" />
    <!-- FrameHash and the APU, which the silence digest is expressed in. Transitive through the
         CLI, named here for the same reason the other test projects name theirs. -->
    <ProjectReference Include="..\..\src\Quarp.Core\Quarp.Core.csproj" />
    <!-- PngDecoder and PngEncoder: the gfx dump tests read the file the tool wrote with the
         very decoder the console loads a cartridge's art through, which is what makes the
         round trip a statement about the console rather than about a test helper. Transitive
         through the CLI as well; named for the same reason as the line above. -->
    <ProjectReference Include="..\..\src\Quarp.CartKit\Quarp.CartKit.csproj" />
  </ItemGroup>
</Project>
