         ("edit the code mid-game and stay in the same place") testable without a display. -->
    <ProjectReference Include="..\..\src\Quarp.Shell.Desktop\Quarp.Shell.Desktop.csproj" />
    <ProjectReference Include="..\..\src\Quarp.CartKit\Quarp.CartKit.csproj" />
    <ProjectReference Include="..\..\src\Quarp.Core\Quarp.Core.csproj" />
  </ItemGroup>
</Project>
